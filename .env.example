# 1. PostgreSQL (Data Warehouse & Airflow Metadata)
POSTGRES_USER=dwh_admin
POSTGRES_PASSWORD=YourSecurePasswordHere!
POSTGRES_DB=space_weather_dwh

# 2. MinIO (Data Lake Bronze)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=YourMinioPasswordHere!
MINIO_BUCKET=space-weather-bronze

# 3. Apache Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=YourAirflowPasswordHere!
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60cSaKS_kNI3D6ZUOwe4h9pkGZOJJIswpo=

# 4. Grafana Monitoring
GF_SECURITY_ADMIN_USER=grafana_admin
GF_SECURITY_ADMIN_PASSWORD=YourGrafanaPasswordHere!

